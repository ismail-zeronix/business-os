# Zeronix Intelligence: environment variables.
# Copy to `.env` (git-ignored) - for local development, from the repo root; for production, at /srv/docker/zeronix/.env
# next to compose.yaml (see the "Production" section at the bottom). These are LOCAL-ONLY defaults. Never commit a real value.

# --- Local PostgreSQL (docker-compose.yml) ---
# Port 5442 is deliberate: other Postgres instances on this machine use 5432. See docs/decisions/0003-local-postgres-isolation.md
ZI_DB_PORT=5442
ZI_DB_USER=zeronix_bi
ZI_DB_PASSWORD=zeronix_bi_dev
ZI_DB_NAME=zeronix_bi

# Use 127.0.0.1, NOT localhost: on this machine localhost can resolve to ::1, which another service owns.
# Keep user/password/port/name in sync with the ZI_DB_* values above.
DATABASE_URL="postgresql://zeronix_bi:zeronix_bi_dev@127.0.0.1:5442/zeronix_bi"

# Separate database used only by automated tests (created by the test harness). Never point this at dev data.
TEST_DATABASE_URL="postgresql://zeronix_bi:zeronix_bi_dev@127.0.0.1:5442/zeronix_bi_test"

# --- Application ---
# Timestamps are stored in UTC and displayed in this timezone.
APP_TIMEZONE=Asia/Dubai

# Sign-in (docs/decisions/0006-sign-in-and-roles.md): until an admin has a password, this seeded development user acts (with admin
# rights) and the app shows a "sign-in is not set up" banner. After first-time setup at /setup the app requires sign-in, and this
# is only the identity scripts such as the mailbox sync act as (falling back to the oldest active admin if this email is gone).
DEV_ACTOR_EMAIL=dev@zeronix.local

# --- Email (IMAP) ---
# Encrypts stored mailbox passwords (AES-256-GCM). REQUIRED to add an email account in Settings.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it means re-entering the mailbox passwords. Never commit a real value.
APP_SECRET_KEY=
# Used by `npm run mail:sync -- --watch` only.
MAIL_SYNC_INTERVAL_MINUTES=5

# --- PDF and outgoing email ---
# The PDF of a quotation (Download PDF, and the email attachment) is made by a Chrome, Chromium or Edge that is already installed. It is
# found automatically at the usual places; set the full path only if yours is somewhere else.
# PDF_BROWSER_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"
# Where this server can reach itself when it opens a page to make a PDF (default http://127.0.0.1:3000).
# APP_INTERNAL_URL="http://127.0.0.1:3000"

# --- Production hardening (leave both empty for local use) ---
# A one-time code that /setup asks for on a fresh deployment, so only the person who installed the system can create the first admin.
# Strongly recommended in production: /setup is open to whoever reaches it first until an admin has a password.
# SETUP_TOKEN=
# Hosts allowed to call server actions when a reverse proxy does not forward the public host (X-Forwarded-Host). Comma separated.
# Caddy's `reverse_proxy` forwards X-Forwarded-Host by default, so this is usually NOT needed even in production;
# set it only if the proxy in front of the app does not forward the public host.
# APP_ALLOWED_ORIGINS="app.example.com"

# =====================================================================================================================
# Production (Docker Compose: compose.yaml, deployed from /srv/docker/zeronix on the VPS). Not used by `npm run dev`.
# =====================================================================================================================
#
# Postgres runs in its own container (`postgres`) on the private `zeronix-net` network only - no host port, not on the
# internet. The app connects to it by Docker DNS, never `localhost`/`127.0.0.1` (that would be the app container itself).
# Reusing the ZI_DB_* names above on purpose (one naming convention for this project); the VALUES must be different
# from your local dev database - generate a real password, do not reuse "zeronix_bi_dev".
#
# ZI_DB_USER=zeronix_bi
# ZI_DB_PASSWORD=<generate a strong password - e.g. `openssl rand -base64 24`>
# ZI_DB_NAME=zeronix_bi
#
# compose.yaml builds DATABASE_URL for both the app and the `migrate` service from the three variables above:
#   postgresql://${ZI_DB_USER}:${ZI_DB_PASSWORD}@postgres:5432/${ZI_DB_NAME}
# Do not also set DATABASE_URL here - compose.yaml sets it on the container directly.
#
# Required (the app container will not start without it - generate the same way as above, keep it stable, back it up
# outside the database: losing it means every stored mailbox password must be re-entered):
# APP_SECRET_KEY=
#
# Optional, same meaning as above; set them here if you want them in production:
# SETUP_TOKEN=
# APP_ALLOWED_ORIGINS=
# APP_TIMEZONE=Asia/Dubai
# MAIL_SYNC_INTERVAL_MINUTES=5
# DEV_ACTOR_EMAIL=dev@zeronix.local
#
# Not set here: PORT, HOSTNAME, NODE_ENV, PDF_BROWSER_PATH, PDF_NO_SANDBOX, APP_INTERNAL_URL - the Dockerfile/
# compose.yaml already set these correctly for the container (0.0.0.0:3000, the installed Chromium, production mode).
